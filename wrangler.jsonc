// Deployed by .github/workflows/site.yml after build.sh renders dist/.
{
  "name": "zaofang-sh",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Every request, so browsers on plain http can be redirected and terminals get index.txt.
    "run_worker_first": true
  },
  "routes": [{ "pattern": "zaofang.sh", "custom_domain": true }],
  "workers_dev": false
}
